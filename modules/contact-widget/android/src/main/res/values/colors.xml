<resources>
  <!-- The app's own background, used whatever the system theme is: a widget sits on the user's
       wallpaper rather than on an app background, so it has to carry its own contrast. The glow
       mesh that goes over this lives in drawable/widget_surface.xml. -->
  <color name="widget_surface">#04060B</color>
  <color name="widget_border">#2A3350</color>
  <color name="widget_text">#F2F4F7</color>
  <color name="widget_text_muted">#98A2B3</color>
  <!-- Translucent rather than a flat fill: the button is a recess in the glow behind it, and a
       solid grey square would sit on the blue like a sticker. -->
  <color name="widget_button">#8C05070D</color>
  <!-- The code itself, on its white quiet zone: near-black rather than pure, to match the app. -->
  <color name="widget_code">#101418</color>
</resources>
